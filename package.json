{
  "name": "paper-route",
  "version": "1.0.0",
  "description": "Save local documents into a 1Password vault with minimal friction",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "vaults": "tsx src/cli.ts vaults",
    "save": "tsx src/cli.ts save"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@1password/sdk": "^0.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
